# ==============================================================================
# AerisPulse Environment Variables Template
# Serverless route handlers strictly isolate all keys. Client bundle has 0 keys.
# ==============================================================================

# Primary GenAI Engine (Google Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Fallback AI Engines (Optional)
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Rate Limiter Threshold (requests per IP per 60s sliding window)
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# Cache TTL Configuration (in milliseconds)
TELEMETRY_CACHE_TTL_MS=300000
